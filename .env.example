# EduShield Environment Configuration Template
# Never commit real service account private keys or secrets

# Firebase Client Configuration (Optional - EduShield automatically runs in full interactive offline mode if omitted)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Google Gemini API Key (Optional - Falls back to EduShield local Continuity Intelligence rule engine if omitted)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
